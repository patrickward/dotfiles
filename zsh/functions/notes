# Notes management system
#
# Usage: notes <command> [options]
#   cd              change to notes directory
#   ls [query]      list notes, optionally filtered
#   rm <file>       remove a note
#   find <query>    search note contents
#   new [title]     create a new note
#   show <file>     view a note
#   edit <file>     edit a note
#   push <msg>      commit and push changes
#   pull            pull changes
#   sync <msg>      commit, pull, and push
#   tags            show all tags
#   subjects        show all subjects
#   contents        generate table of contents
notes() {
    : ${NOTES_DIR:="$HOME/notes"}
    : ${EDITOR:="vim"}

    local RED='\033[0;31m'
    local GREEN='\033[0;32m'
    local ORANGE='\033[0;33m'
    local PURPLE='\033[0;35m'
    local NC='\033[0m'

    _notes_error() {
        echo "${RED}$1${NC}"
        [[ $# -eq 1 ]] && _notes_usage
    }

    _notes_usage() {
        cat <<EOF

notes — manage notes in $NOTES_DIR

Usage: notes <command> [options]

  cd                  change to notes directory
  ls [query]          list notes, optionally filtered
  rm <file>           remove a note
  find|search <query> search note contents
  new [title] [subj] [tags]  create a new note
  show <file>         view a note (uses bat if available)
  edit <file>         open a note in \$EDITOR
  push <msg>          git commit and push
  pull                git pull
  sync <msg>          git commit, pull, and push
  tags                list all tags
  subjects            list all subjects
  contents            generate index.md

EOF
    }

    _notes_find() {
        grep -r "$NOTES_DIR" -li -e "$*" 2>/dev/null \
            | sed -E "s|^$NOTES_DIR/||" | sed -E 's|^/+||'
    }

    _notes_new() {
        local title="$1" subject="$2" tags="$3"
        [[ -z "$title" ]] && read -r "title?Title: "
        [[ -z "$subject" ]] && read -r "subject?Subject (e.g. +project): "
        [[ -z "$tags" ]] && read -r "tags?Tags (e.g. @tag1 @tag2): "
        [[ -z "$title" ]] && { _notes_error "Title is required"; return 1; }

        local filename="${${title:l}//[^a-zA-Z0-9@]/-}.md"
        [[ $filename =~ .*meeting.* ]] && filename="meetings/$filename"

        if [[ -f "$filename" ]]; then
            echo "${ORANGE}File '$filename' already exists.${NC}"
            echo "1) Overwrite  2) New with suffix  3) Cancel"
            read -r "choice?Choice (1-3): "
            case $choice in
                1) ;;
                2) filename="${filename%.md}-$(openssl rand -hex 4).md" ;;
                *) echo "Cancelled"; return 0 ;;
            esac
        fi

        local template="$NOTES_DIR/../templates/default.md"
        [[ ! -f "$template" ]] && { _notes_error "Template not found: $template"; return 1; }

        cp "$template" "$filename"
        sed -i.bak \
            -e "s/{title}/$title/g" \
            -e "s/{date}/$(date '+%Y-%m-%d %H:%M:%S')/g" \
            -e "s/{subject}/$subject/g" \
            -e "s/{tags}/$tags/g" "$filename" && rm "$filename.bak"

        echo "${GREEN}Created: $filename${NC}"
        $EDITOR "$filename"
    }

    _notes_view() {
        if command -v bat &>/dev/null; then
            bat --style=plain --theme=ansi "$1"
        else
            ${PAGER:-less} "$1"
        fi
    }

    _notes_metadata() {
        grep -h "$2" "$NOTES_DIR"/*.md 2>/dev/null | tr ' ' '\n' \
            | grep "^$2" | sort | uniq -c \
            | awk -v oc="$ORANGE" -v pc="$PURPLE" -v nc="$NC" \
                  '{printf "%s%4d %s%s%s\n", oc, $1, pc, $2, nc}'
    }

    [[ ! -d "$NOTES_DIR" ]] && mkdir -p "$NOTES_DIR"

    case "$1" in
        cd) cd "$NOTES_DIR" ;;
        ls|list) ls -1 "$NOTES_DIR"${2:+/*$2*} ;;
        rm)
            local f="$NOTES_DIR/$2"
            [[ ! -f "$f" ]] && { _notes_error "Not found: $2"; return 1; }
            read -q "?Remove $2? (y/n) " && rm "$f" || echo "Cancelled"
            ;;
        f|s|find|search) _notes_find "${@:2}" ;;
        n|new) (cd "$NOTES_DIR" && _notes_new "$2" "$3" "$4") ;;
        v|view|show)
            local f="$NOTES_DIR/$2"
            [[ ! -f "$f" ]] && { _notes_error "Not found: $2"; return 1; }
            _notes_view "$f"
            ;;
        e|edit)
            local f="$NOTES_DIR/$2"
            [[ ! -f "$f" ]] && { _notes_error "Not found: $2"; return 1; }
            $EDITOR "$f"
            ;;
        push|pull|sync)
            (cd "$NOTES_DIR/.." || return 1
            case "$1" in
                push)
                    [[ -z "$2" ]] && { _notes_error "Commit message required"; return 1; }
                    git add -A && git commit -m "$2" && git push ;;
                pull) git pull ;;
                sync)
                    [[ -z "$2" ]] && { _notes_error "Commit message required"; return 1; }
                    git add -A && git commit -m "$2" && git pull && git push ;;
            esac)
            ;;
        tags)     _notes_metadata "tags" "@" ;;
        subjects) _notes_metadata "subjects" "+" ;;
        contents)
            {
                echo "# Notes\n\n---\n"
                find "$NOTES_DIR" -name "*.md" | sort | while read -r f; do
                    local title
                    title=$(sed -n 's/^# //p' "$f" | head -1)
                    echo "* [${title:-$(basename "$f")}]($f)"
                done
            } > "$NOTES_DIR/index.md"
            ${PAGER:-less} "$NOTES_DIR/index.md"
            ;;
        help|-h|--help) _notes_usage ;;
        "")  _notes_usage; return 1 ;;
        *)
            local f="$NOTES_DIR/$1"
            [[ ! -f "$f" ]] && { _notes_error "Not found: $1"; return 1; }
            _notes_view "$f"
            ;;
    esac
}
