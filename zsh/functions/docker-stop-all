# Stop all running Docker containers
docker-stop-all() {
    local containers
    containers=$(docker ps -q)
    if [[ -z "$containers" ]]; then
        echo "No running containers"
        return 0
    fi

    local count
    count=$(echo "$containers" | wc -l | tr -d ' ')
    echo "Stopping $count container(s)..."
    docker stop $containers
}
