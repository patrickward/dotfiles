# Follow Docker Compose logs
#
# Usage:
#   dc-logs              All services
#   dc-logs web          Specific service
#   dc-logs web 50       Last 50 lines from a service
dc-logs() {
    local service=${1:-}
    local lines=${2:-100}

    if [[ -n "$service" ]]; then
        docker compose logs -f --tail="$lines" "$service"
    else
        docker compose logs -f --tail="$lines"
    fi
}
