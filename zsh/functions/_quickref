#compdef quickref

_quickref() {
    local -a sections
    sections=(
        'commands:Show zsh functions, topic helpers, and bin scripts'
        'functions:Show autoloaded zsh/functions helpers'
        'topics:Show functions from topic .zsh files'
        'bin:Show executable scripts from bin/'
        'docs:Show docs/*.md files'
        'aliases:Show active shell aliases'
        'all:Show everything'
        'help:Show usage menu'
    )

    _arguments \
        '(-v --verbose)'{-v,--verbose}'[Show source paths]' \
        '(-f --filter)'{-f,--filter}'[Filter names/descriptions]:filter text:' \
        '(-h --help)'{-h,--help}'[Show usage menu]' \
        '1:section or search term:->section_or_search' \
        '*::extra arguments:->extra'

    case "$state" in
        section_or_search)
            _describe 'section' sections
            ;;
        extra)
            ;;
    esac
}

_quickref "$@"