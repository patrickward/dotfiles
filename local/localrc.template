# local/localrc.template
#
# Template for ~/.localrc — machine-specific shell configuration.
#
# HOW TO USE:
#   cp $DOTFILES/local/localrc.template ~/.localrc
#   Edit ~/.localrc with your machine-specific settings.
#   ~/.localrc is gitignored and never committed.
#
# LOAD ORDER:
#   ~/.localrc is sourced TWICE per interactive shell session:
#     1. From zshenv  — runs for ALL zsh invocations (interactive, scripts, scp, etc.)
#     2. From zshrc   — runs for interactive shells only
#
#   Because of #1, follow this rule:
#     - Never produce output here (no echo, print, etc.)
#     - Guard interactive-only things with: [[ $- == *i* ]] && ...
#     - Environment variables and PATH additions are always safe.
#
# WHAT BELONGS HERE:
#   - API keys, tokens, and credentials (never commit these)
#   - PATH additions for tools installed outside the dotfiles (Herd, company tools)
#   - Machine identity (work vs. personal)
#   - Tool injections added by installers (e.g., Herd, asdf, volta)
#   - Anything that differs between your machines
#
# WHAT DOES NOT BELONG HERE:
#   - General aliases or functions → zsh/config/aliases.zsh or zsh/functions/
#   - Tool configuration shared across machines → topics/<tool>/
#   - PATH entries that belong to a specific tool → topics/<tool>/path.zsh

# ---------------------------------------------------------------------------
# Machine identity (optional but useful for conditional config)
# ---------------------------------------------------------------------------
# export MACHINE="work"      # or "personal", "server", etc.
# export WORK_EMAIL="you@company.com"

# ---------------------------------------------------------------------------
# API keys and credentials
#
# Keep secrets here, not in the repo. If you use a secrets manager
# (1Password CLI, macOS Keychain, etc.), prefer loading from there.
# ---------------------------------------------------------------------------
# export GITHUB_TOKEN=""
# export ANTHROPIC_API_KEY=""
# export OPENAI_API_KEY=""
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export AWS_DEFAULT_REGION="us-east-1"

# ---------------------------------------------------------------------------
# Machine-specific PATH additions
#
# Add paths for tools installed outside the dotfiles (e.g., company tools,
# language version managers injected by an installer, etc.)
# ---------------------------------------------------------------------------
# export PATH="$HOME/.local/bin/company-tools:$PATH"

# ---------------------------------------------------------------------------
# Tool injections
#
# Installers often append their own init blocks here (Herd, conda, volta,
# nvm, etc.). Paste them in this section rather than letting them pile up
# at the bottom without context.
#
# Laravel Herd (PHP development environment):
# ---------------------------------------------------------------------------
# export PATH="/Users/$USER/Library/Application Support/Herd/bin/:$PATH"
# export HERD_PHP_83_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/83/"

# ---------------------------------------------------------------------------
# Work-specific configuration
#
# Use MACHINE or hostname to keep work and personal config in one file.
# `scutil --get ComputerName` (macOS) or `hostname -s` (portable) give the
# machine name if you prefer that over a manual MACHINE variable.
# ---------------------------------------------------------------------------
# if [[ "$MACHINE" == "work" ]]; then
#     export HTTP_PROXY="http://proxy.company.com:8080"
#     export HTTPS_PROXY="$HTTP_PROXY"
#     export NO_PROXY="localhost,127.0.0.1,.company.com"
#     export GIT_AUTHOR_EMAIL="$WORK_EMAIL"
#     export GIT_COMMITTER_EMAIL="$WORK_EMAIL"
# fi

# ---------------------------------------------------------------------------
# Interactive-only overrides
#
# Aliases or functions that only make sense on this machine. Keep this
# minimal — if you find yourself adding many things here, it likely belongs
# in a topic instead.
#
# Guard with the interactive check so this block is safe in all contexts.
# ---------------------------------------------------------------------------
# if [[ $- == *i* ]]; then
#     # Example: alias for a company-specific VPN tool
#     # alias vpn-up='sudo openconnect vpn.company.com'
# fi
