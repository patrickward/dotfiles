# bind is an alias for bind-key
# set  is an alias for set-option

# ===========================================================================
# Prefix key: C-a (CHANGED from default C-b, like GNU Screen)
# ===========================================================================
set -g prefix C-a
unbind C-b
bind a send-prefix       # prefix + a sends C-a to inner app
bind C-a send-prefix     # prefix + C-a also sends C-a (for nested tmux)

# ===========================================================================
# General settings
# ===========================================================================
set -g base-index 1           # CHANGED default (0); windows start at 1
setw -g pane-base-index 1     # CHANGED default (0); panes start at 1
set -g renumber-windows on    # CHANGED default (off); keep window numbers contiguous
set -g history-limit 50000    # CHANGED default (2000); more scrollback
set -g focus-events on        # CHANGED default (off); required for neovim FocusGained/Lost
set -g display-time 4000      # CHANGED default (750ms); messages stay visible longer

# ===========================================================================
# Mouse and display
# ===========================================================================
set -g mouse on               # Default ON in tmux 3.7 (explicit for documentation)
set -g default-terminal 'tmux-256color'
set -g default-shell /bin/zsh

# Window title reflects tmux session name in terminal titlebar
set -g set-titles on
set -g set-titles-string '#S:#W.#P' # Show session name and pane/window number

# Activity monitoring
setw -g monitor-activity on
set -g visual-activity on

# Pane border colors (256-color)
set -g pane-border-style fg=colour235
set -g pane-active-border-style fg=colour240

# ===========================================================================
# Key bindings
# ===========================================================================

# Reload config (CHANGED default: no default reload binding)
bind r source-file ~/.tmux.conf \; display ".tmux.conf reloaded!"

# Splits in current directory (CHANGED defaults: default is - and | without -c)
bind - split-window -v -c '#{pane_current_path}'
bind \\ split-window -h -c '#{pane_current_path}'

# Pane navigation, Vim-style without prefix (CHANGED default: prefix + arrow keys)
bind -n C-h select-pane -L
bind -n C-j select-pane -D
bind -n C-k select-pane -U
bind -n C-l select-pane -R

# Pane resizing without prefix
bind -n S-Left  resize-pane -L 2
bind -n S-Right resize-pane -R 2
bind -n S-Down  resize-pane -D 1
bind -n S-Up    resize-pane -U 1

# New window in current directory (CHANGED default: opens in home dir)
bind c new-window -c '#{pane_current_path}'

# Break pane into new window (detached)
bind b break-pane -d

# Session chooser (tree view)
bind C-j choose-tree

# ---------------------------------------------------------------------------
# Quick panes (persistent splits — stay open alongside your work)
# ---------------------------------------------------------------------------
bind h split-window -h "htop"                          # System monitor
bind D split-window -h "docker stats"                  # Container stats
bind L split-window -v -c '#{pane_current_path}' "tail -f log/development.log"

# ---------------------------------------------------------------------------
# Popups (floating — dismiss when done, no layout disruption)
# ---------------------------------------------------------------------------
bind p display-popup -E -w 80% -h 70% -d '#{pane_current_path}'  # Scratch shell
bind m command-prompt -p "man page:" "display-popup -E -w 80% -h 80% 'man %%'" # Man page
bind = display-popup -E -w 40% -h 30% "bc -l" # Calculator

# ===========================================================================
# Copy mode (vi-style, pipe to macOS clipboard via pbcopy)
# ===========================================================================
bind-key -T copy-mode-vi v              send -X begin-selection
bind-key -T copy-mode-vi y              send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi Enter          send-keys -X copy-pipe-and-cancel "pbcopy"

# ===========================================================================
# Stay in tmux always
# Requires: tat script in $PATH (creates session named after current dir)
# See: https://github.com/thoughtbot/dotfiles/blob/main/bin/tat
# ===========================================================================

# Break current pane into a new named session (via tat), then exit shell
bind-key C-b send-keys 'tat && exit' 'C-m'

# Kill current session and switch to next — never drops to bare terminal
bind-key K run-shell 'tmux switch-client -n \; kill-session -t "$(tmux display-message -p "#S")" || tmux kill-session'
