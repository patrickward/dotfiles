# brew "postgis"        # Postgres spatial/GIS extension (uncomment if needed)

# ---------------------------------------------------------------------------
# Image processing
# ---------------------------------------------------------------------------
brew "imagemagick"
brew "vips"             # High-performance image processing

# ---------------------------------------------------------------------------
# Network & utilities
# ---------------------------------------------------------------------------
brew "nmap"
brew "pandoc"           # Document converter
brew "lynx"             # Terminal browser
# brew "s3cmd"          # S3 CLI (uncomment if needed; aws-cli is an alternative)

