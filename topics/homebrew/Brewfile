  # --- Database GUIs ---
  # cask "tableplus"          # Native DB GUI — Postgres, MySQL, SQLite, Redis, MongoDB and more; fast, clean
  # cask "dbeaver-community"  # Free, heavier DB client; handles obscure drivers well

  # --- API / HTTP / Network ---
  # cask "proxyman"           # Native macOS HTTP proxy with SSL inspection — essential for API debugging
  # cask "mitmproxy"          # CLI-first, scriptable HTTP proxy — automate traffic interception in CI
  # cask "insomnia"           # REST/GraphQL/gRPC GUI client

  # --- Containers & Virtualization ---
  cask "orbstack"           # Docker Desktop replacement — faster, lighter, native Apple Silicon; runs Linux VMs too
  # cask "utm"                # QEMU-based VM manager — free, runs ARM and x86 VMs; disposable sandboxes

  # --- Security ---
  # cask "1password"          # Password manager — gold standard; pair with brew "1password-cli" for terminal
  # cask "bitwarden"          # Open-source password manager alternative
  # cask "apparency"          # Quick Look plugin — inspect .app code signing and notarization before running
  # cask "suspicious-package" # Quick Look plugin — inspect .pkg install scripts before running
  # cask "little-snitch"      # Outbound firewall — audits what processes phone home; ~$70

  # --- macOS Productivity & Ergonomics ---
  # Still using Alfred, but raycast is a nice alternative
