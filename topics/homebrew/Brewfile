  # cask "karabiner-elements" # Keyboard remapper — Caps Lock → Esc/Ctrl, Hyper key, app-specific binds
  # cask "thaw"               # Menu bar icon manager — open-source Bartender/Ice successor (macOS 14/15)
  cask "thaw@beta"            # Thaw v2 beta — use this on macOS 26 (Tahoe) instead of cask "thaw"
  cask "cleanshot"            # Screenshot, scrolling capture, GIF/video recording — replaces multiple tools
  # Installed directly, but keeping here for options
  # cask "dash"                 # Offline API docs — 200+ docsets (MDN, Go, Rust, AWS SDK, etc.); ~$30

  # --- Media ---
  cask "vlc"                  # Open source media player; handles virtually every codec
  cask "calibre"              # Ebook management, conversion, and library organization

  # --- Go release tooling ---
  cask "goreleaser/tap/goreleaser"  # Go release automation (cross-compile, sign, publish binaries)

  # --- Tunneling (requires free ngrok account + `ngrok config add-authtoken <token>`) ---
  cask "ngrok"                # Reverse proxy / secure tunnel to localhost for webhook testing

  # --- LaTeX (heavy, ~5 GB; required for pandoc PDF export) ---
  # cask "mactex"             # Full TeX Live distribution for macOS

end

# ---------------------------------------------------------------------------
# Fonts (macOS only via cask; on Linux install via distro package manager)
# ---------------------------------------------------------------------------
if OS.mac?
  cask "font-jetbrains-mono-nerd-font"  # JetBrains Mono with Nerd Font icon glyphs — terminal default
  cask "font-fira-code-nerd-font"       # Fira Code with ligatures + Nerd Font glyphs
  # cask "font-monaspace-nerd-font"     # Monaspace — GitHub's variable-axis font family
