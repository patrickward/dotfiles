# Brewfile
#
# Managed by zdot. Run `brew bundle` to install.
# Run `brew bundle cleanup` to remove packages not listed here.
#
# Supply chain policy:
#   - No third-party taps (use official install methods for those tools)
#   - Runtimes (Go, Node, Python, Ruby) via mise or direct install, not brew
#   - Prefer the main homebrew tap; review any new addition before adding
#
# Go: install from https://go.dev/dl/ or via mise (mise install go)
# Node, Python, Ruby: managed via mise (https://mise.jdx.dev)
#
# After `brew bundle`, run your post-install script for:
#   - Adding $(brew --prefix)/bin/bash to /etc/shells (keg-only shells)
#   - Registering dnsmasq / mailpit as launchd services (macOS)

# ---------------------------------------------------------------------------
# Taps
# ---------------------------------------------------------------------------
tap "goreleaser/tap"

# ---------------------------------------------------------------------------
# Shell & CLI core
# ---------------------------------------------------------------------------
brew "bash"         if OS.mac?  # Newer bash (macOS ships v3 due to GPLv3); keg-only: needs PATH wiring
brew "grep"         if OS.mac?  # GNU grep (macOS ships BSD grep with incompatible flags)
brew "gnu-sed"      if OS.mac?  # GNU sed (macOS sed -i syntax differs; scripts break cross-platform)
brew "git"                      # Version control
brew "lazygit"                  # Terminal UI for git
brew "git-lfs"                  # Git Large File Storage for binary assets
brew "gh"                       # GitHub CLI — PRs, issues, workflows from the terminal
brew "curl"                     # HTTP client; newer than macOS system curl (supports HTTP/3)
brew "httpie"                   # Alternative to curl
brew "wget"                     # HTTP downloader; useful for scripting where curl idioms are awkward
brew "gnupg"                    # GNU Privacy Guard — signing, encryption, SSH key agent
brew "shellcheck"               # Static analysis for bash/sh scripts; catches common pitfalls
brew "tree"                     # Directory tree listing

# ---------------------------------------------------------------------------
# Shell utilities & productivity
# ---------------------------------------------------------------------------
brew "tmux"         # Terminal multiplexer — persistent sessions, pane splitting
brew "fzf"          # Fuzzy finder — shell history, file picker, general interactive filter
brew "bat"          # Syntax-highlighted cat replacement; used in notes function
brew "jq"           # JSON processor and query tool (like sed/awk for JSON)
brew "ripgrep"      # Fast recursive grep (rg) — respects .gitignore, significantly faster than ag
brew "gum"          # Composable shell UI components — prompts, spinners, selectors in scripts
# brew "eza"        # Modern ls replacement — Git status, icons, tree view; aliases: ls="eza" ll="eza -la --git"
# brew "fd"         # Modern find replacement — respects .gitignore, friendlier syntax than find
# brew "zoxide"     # Smarter cd — tracks visit frequency; jump with `z proj` instead of full path
brew "htop"         # Interactive process viewer — color-coded per-core CPU/mem, consistent cross-platform

# ---------------------------------------------------------------------------
# Build tools
# ---------------------------------------------------------------------------
brew "gcc"          # GNU compiler collection — needed by many gems, extensions, native addons
brew "cmake"        # Cross-platform build system generator — required by many C/C++ projects
brew "autoconf"     # Generates configure scripts for GNU-style build systems
brew "automake"     # Generates Makefile.in files; companion to autoconf

# ---------------------------------------------------------------------------
# Languages (non-mise managed)
# ---------------------------------------------------------------------------
# PHP and Composer are managed here, not via mise, because they are used
# as CLI tools (e.g. composer global installs) rather than per-project runtimes.
brew "php"          # PHP CLI + php-fpm (used for local *.test sites via Caddy)
brew "composer"     # PHP dependency manager

# ---------------------------------------------------------------------------
# Editors & code navigation
# ---------------------------------------------------------------------------
brew "vim"              # Vi IMproved — terminal editor; fallback when GUI editors unavailable
brew "universal-ctags"  # Source code indexing for vim/neovim tag navigation
# brew "helix"          # Modern modal editor (vim-like); pure Rust, built-in LSP

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
brew "redis"        # In-memory data store — used as cache, queue, pub/sub
brew "sqlite"       # Embedded SQL database; used by many tools as local storage

# PostgreSQL: use Postgres.app (https://postgresapp.com) — better multi-version support than brew
# brew "postgresql" # Postgres server (prefer Docker/OrbStack for isolation)
# brew "pgloader"   # Postgres data migration tool — CSV, MySQL, SQLite → Postgres
# brew "postgis"    # Postgres spatial/GIS extension
brew "pgcli"        # Postgres REPL with autocomplete, syntax highlighting, pager

# MySQL, Redis, and other services: run via Docker/OrbStack when needed
# Example: docker run -d -p 3306:3306 -e MYSQL_ROOT_PASSWORD=root mysql:8
# Example: docker run -d -p 6379:6379 redis:alpine

# ---------------------------------------------------------------------------
# Media & graphics
# ---------------------------------------------------------------------------
brew "ffmpeg"       # Audio/video encoding, decoding, streaming, transcoding
brew "imagemagick"  # Image conversion, resizing, compositing from CLI
brew "vips"         # High-performance image processing library; faster than ImageMagick for web use
brew "svgo"         # SVG optimization — removes redundant attributes, minifies output
# brew "mpv"        # Lightweight media player with good CLI scripting support

# ---------------------------------------------------------------------------
# Dev tools & documentation
# ---------------------------------------------------------------------------
brew "d2"           # Declarative text-to-diagram tool (like Mermaid, but more expressive)
brew "pandoc"       # Universal document converter — Markdown → PDF/DOCX/HTML/EPUB etc.
brew "lynx"         # Terminal web browser — useful for quick HTML inspection or CI checks

# ---------------------------------------------------------------------------
# Network & local dev infrastructure
# ---------------------------------------------------------------------------
brew "openssl"      # SSL/TLS library (keg-only — does NOT shadow system OpenSSL without PATH wiring)
brew "nmap"         # Network scanner and port mapper — host discovery, service fingerprinting
brew "ansible"      # Agentless IT automation — config management, provisioning, orchestration
brew "caddy"        # HTTP/2 server with automatic HTTPS — useful for local HTTPS dev proxy
brew "dnsmasq"      # Lightweight DNS server — local *.test / *.localhost domain resolution
brew "mailpit"      # Local SMTP server with web UI for catching outbound email in development
# brew "pgrok"      # Open-source ngrok alternative — HTTP tunnels, no account required
# brew "s3cmd"      # S3 CLI (alternative: aws-cli via mise or direct install)
# brew "overmind"   # Procfile process manager with tmux integration

# ---------------------------------------------------------------------------
# macOS-only: GUI apps (casks) and macOS-specific CLI
# ---------------------------------------------------------------------------
if OS.mac?

  # --- Terminals ---
  cask "ghostty"              # Fast, GPU-accelerated terminal with native macOS UI; requires macOS ≥ 13

  # --- Editors & IDEs ---
  # cask "visual-studio-code" # Microsoft VS Code — most widely used editor; large extension ecosystem
