  # cask "cursor"             # VS Code fork with deep AI code assistance built in

  # --- Browsers (uncomment what you use) ---
  # cask "firefox"            # Mozilla Firefox — open source, strong privacy defaults, but has built-in AI
  # cask "brave-browser"      # Chromium-based; built-in ad/tracker blocking, no Google telemetry
  cask "zen"                  # Firefox-based; vertical sidebar, workspaces, split view (Arc successor)
