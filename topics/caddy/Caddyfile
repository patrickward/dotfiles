# Caddyfile — managed by dotfiles
#
# This is a template. setup.sh rewrites the placeholder in the import path
# below to the real brew prefix when installing to
# $(brew --prefix)/etc/Caddyfile. Keep that placeholder out of these
# comments, or they get rewritten too.
#
# Per-site configs: $(brew --prefix)/etc/caddy/sites/*.caddy
#
# Caddy generates a local CA and signs certs automatically.
# Run `caddy trust` once to add it to the macOS Keychain (setup.sh does this).

{
    # Use Caddy's built-in local CA instead of Let's Encrypt.
    # Required for *.test domains (not publicly resolvable).
    local_certs
}

# Import per-site configs. Add files to:
#   $(brew --prefix)/etc/caddy/sites/<project>.caddy
#
# Site configs are intentionally NOT tracked in dotfiles — projects differ
# per machine. See topics/homebrew/README.md for site config examples.
#
# A glob matching zero files is not an error: with an empty sites/ directory
# Caddy starts but serves nothing (admin API on :2019 only).
import BREW_PREFIX/etc/caddy/sites/*.caddy
