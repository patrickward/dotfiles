#!/usr/bin/env bash
# Show the tmux cheatsheet for this configuration

. "$DOTFILES/lib/utils.sh"

echo ""
okay "TMUX Cheatsheet (prefix: C-a)"
echo ""
echo "  Splits"
echo "    prefix + -        split vertically (current dir)"
echo "    prefix + \\        split horizontally (current dir)"
echo ""
echo "  Panes"
echo "    C-{h,j,k,l}       navigate panes (no prefix)"
echo "    S-{arrows}         resize panes (no prefix)"
echo ""
echo "  Windows & Sessions"
echo "    prefix + c        new window (current dir)"
echo "    prefix + b        break pane into new window"
echo "    prefix + C-j      choose session tree"
echo "    prefix + C-b      break into new session"
echo "    prefix + K        kill session, switch to next"
echo ""
echo "  Other"
echo "    prefix + r        reload tmux.conf"
echo "    prefix + h        open htop in a split"
